{
  "name": "polypack",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @polypack/server & npm run dev --workspace @polypack/web",
    "build": "npm run build --workspace @polypack/web",
    "build:volunteer": "npm run build --workspace @polypack/volunteer",
    "start": "npm run start --workspace @polypack/server",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "playwright test",
    "test:python": "python3 python/test_corpus.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "fast-check": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9"
  }
}
